prepareSettings() {
	local outdir="$1"
	local src_scriptspath="$2"
	
	[ -d "$outdir" ] || mkdir -p "$outdir"
	create_settings_shortcut "$usb_c2m_games_root/"
	create_back_shortcut "$outdir/"
	
	# remove all settings that are not available in source settings dir
	for installed_scriptpath in "$outdir"/CLV-S-00???/*.sh; do
		if [ -f "$installed_scriptpath" ]; then
			installed_script="$(basename "$installed_scriptpath")"
			is_available=0
			for available_scriptpath in "$src_scriptspath"/*.sh; do
				available_script="$(basename "$available_scriptpath")"
				available_script="$(echo "$available_script" | sed -e 's/ /_/g')"
				if [ "$available_script" = "$installed_script" ]; then
					is_available=1
					break
				fi
			done
			if [ "$is_available" -eq 0 ]; then
				basedir="$(dirname "$installed_scriptpath")"
				echo "removing setting $basedir"
				rm -rf "$basedir"
			fi
		fi
	done
	
	# add all settings from source settings dir that are not already installed
	gamecode_num=1
	for available_scriptpath in "$src_scriptspath"/*.sh; do
		if [ -f "$available_scriptpath" ]; then
			available_script="$(basename "$available_scriptpath")"
			local filename="$available_script"
			name="${available_script%.*}"
			available_script="$(echo "$available_script" | sed -e 's/ /_/g')"
			is_installed=0
			for installed_scriptpath in "$outdir"/CLV-S-00???/*.sh; do
				installed_script="$(basename "$installed_scriptpath")"
				if [ "$available_script" = "$installed_script" ]; then
					is_installed=1
					# if it is installed, check that the script hasn't changed
					if ! diff -q "$available_scriptpath" "$installed_scriptpath" &>/dev/null; then
						echo "updating setting $installed_scriptpath"
						cp "$available_scriptpath" "$installed_scriptpath"
						chmod +x "$installed_scriptpath"
					fi
					break
				fi
			done
			
			if [ "$is_installed" -eq 0 ]; then
				# get next gamecode to use
				while true; do
					gamecode=$(printf "CLV-S-%05d" $gamecode_num)
					let gamecode_num++
					if ! [ -d "$outdir/$gamecode" ]; then
						break
					fi
				done
				local srcdir="$src_scriptspath"
				local destdir="$outdir/$gamecode"
				mkdir -p "$destdir"
				
				dest_script_filepath="$destdir/$available_script"
				toggleImportingLogo
				echo "      creating setting $dest_script_filepath" | tee /dev/tty0
				
				create_shortcut "$outdir/" "$gamecode" settings "$name" "/var/games/$gamecode/$available_script" $ALIGN_NONE
				dos2unix "$available_scriptpath"
				cp "$available_scriptpath" "$dest_script_filepath"
				chmod +x "$dest_script_filepath"
				
				# copy over any special icon/boxart image
				local img_src_filepath="$srcdir/${filename%.*}".png
				[ -f "$img_src_filepath" ] || img_src_filepath="$destdir/${filename%.*}".jpg
				if [ -f "$img_src_filepath" ]; then
					convertImageBoth "$img_src_filepath" "$destdir/$gamecode.png" "$destdir/$gamecode"_small.png
				fi
			fi
		fi
	done
}

importGame() {
	local romfilepath="$1"
	local outdir="$2"
	local is_fave="$3"
	local baddir="$4"
	local gooddir="$5"
	
	local filename="$(basename "$romfilepath")"
	local basedir="$(dirname "$romfilepath")"
#	echo "importGame filename = $filename"
#	echo "importGame basedir = $basedir"
	
	# Turn on a case-insensitive matching (-s set nocasematch)
	case "$filename" in
	*.[Pp][Nn][Gg]) echo "ignoring png  file: $filename" ;;
	*.[Jj][Pp][Gg]) echo "ignoring jpg  file: $filename" ;;
	*.[Jj][Ss][Oo][Nn]) echo "ignoring json file: $filename" ;;
	readme.txt) echo "ignoring readme file: $filename" ;;
	*)
		# check for image or database files for this rom
		local db_filepath="$basedir/${filename%.*}".json
#		echo "importGame db_filepath = $db_filepath"
		[ -f "$db_filepath" ] || db_filepath=""
		local img_filepath="$basedir/${filename%.*}".png
#		echo "importGame img_filepath = $img_filepath"
		[ -f "$img_filepath" ] || img_filepath="$basedir/${filename%.*}".jpg
#		echo "importGame img_filepath = $img_filepath"
		[ -f "$img_filepath" ] || img_filepath=""
#		echo "importGame img_filepath = $img_filepath"
		# prepare image and data base params
		local db_param=""
		local img_param=""
		[ -f "$db_filepath"  ] && db_param="-j$db_filepath"
		[ -f "$img_filepath" ] && img_param="-y$img_filepath"
		# do it
		toggleImportingLogo
		if [ "$is_fave" = 0 ]; then
			# not fave game
			echo "      importing game $filename" | tee /dev/tty0
			outdir_param="-e$outdir"
		else
			# is fave game
			echo "      importing fave game $filename" | tee /dev/tty0
			outdir_param="-d$outdir"
		fi
		mkdir -p "$outdir"
#		echo c2romtool cmdline:
#		echo "$usb_c2mromtool" -x "$usb_c2mromtool_data" -r "$romfilepath" "$outdir_param" "$db_param" "$img_param"
		if "$usb_c2mromtool" -x "$usb_c2mromtool_data" -r "$romfilepath" "$outdir_param" "$db_param" "$img_param"; then
			if [ -z "$keep_roms" ]; then
				rm "$romfilepath"
				[ -z "$img_filepath" ] || rm "$img_filepath"
				[ -z "$db_filepath"  ] || rm "$db_filepath"
			else
				mkdir -p "$gooddir"
				mv "$romfilepath"  "$gooddir"
				[ -z "$img_filepath" ] || mv "$img_filepath" "$gooddir"
				[ -z "$db_filepath"  ] || mv "$db_filepath"  "$gooddir"
			fi
		else
			mkdir -p "$baddir"
			mv "$romfilepath"  "$baddir"
			[ -z "$img_filepath" ] || mv "$img_filepath" "$baddir"
			[ -z "$db_filepath"  ] || mv "$db_filepath"  "$baddir"
		fi
	esac
}

importAllGames(){
	local indir="$1"
	local outdir="$2"
	local baddir="$indir"/bad
	local gooddir="$indir"/good
	
	# import/convert general games
	if [ -d "$indir" ]; then
		for romfilepath in "$indir"/* ; do
			if [ -f "$romfilepath" ]; then
				importGame "$romfilepath" "$outdir" 0 "$baddir" "$gooddir"
			fi
		done
		mv "$indir"/*.json "$baddir" 2>/dev/null
		mv "$indir"/*.png "$baddir" 2>/dev/null
		mv "$indir"/*.jpg "$baddir" 2>/dev/null
	fi
}

importFaveGames(){
	local indir="$1"
	local outdir="$2"
	local baddir="$indir"/bad
	local gooddir="$indir"/good
	
	# import/convert fave games
	if [ -d "$indir" ]; then
		for romfilepath in "$indir"/* ; do
			if [ -f "$romfilepath" ]; then
				importGame "$romfilepath" "$outdir" 1 "$baddir" "$gooddir"
			fi
		done
	fi
	
	# create shortcuts if games exist in output dir
	if containsGames "$outdir"; then
		# add shortcut to fave games from root
		create_fave_shortcut "$usb_c2m_games_root/"
		# add shortcut to root from fave games
		create_back_shortcut "$outdir/"
	# remove shortcuts if they don't exist
	else
		rm -rf "${usb_c2m_games_root:?}/${gamecode_fave:?}"
		rm -rf "$outdir"
	fi
}

importOriginalGames(){
	local indir="$1"
	local outdir="$usb_c2m_games_original_dir"
	
	# import/convert original games
	if [ -d "$indir" ]; then
		# create output dir if it doesnt exist
		[ -d "$outdir" ] || mkdir -p "$outdir"
		
		# check each game that is currently in the original games dir
		# to ensure it exists on the current system.
		# if it does not exist, then remove the game.
		echo removing originals
		for gamedir in "$outdir"/CLV-*/ ; do
			local gamecode="$(basename "$gamedir")"
			if ! [ -d "$indir/$gamecode" ] && [ -d "gamedir" ] && [ "$gamecode" != "$gamecode_back" ]; then
				toggleImportingLogo
				echo "      removing original game $gamedir" | tee /dev/tty0
				rm -rf "$gamedir"
			fi
		done
		
		# copy in original games if they dont already exist
		echo copying in originals
		for gamedir in "$indir"/CLV-*/ ; do
			local gamecode="$(basename "$gamedir")"
			local desktop="$outdir/$gamecode/$gamecode.desktop"
			if ! [ -d "$outdir/$gamecode" ]; then
				toggleImportingLogo
				echo "      importing original game $gamedir" | tee /dev/tty0
				cp -rf "$gamedir" "$outdir/"
				# patch rompath and icon path
				sed -i.bak 's#/usr/share/games/nes/kachikachi#/var/games#g' "$desktop"
				sed -i.bak 's#/usr/share/games#/var/games#g' "$desktop"
				# patch savepath
				sed -i.bak 's#/var/lib/clover/profiles/0/#/var/saves#g' "$desktop"
				# remove temp file
				rm -f "$desktop".bak
			fi
		done
		
		# copy across savegames - only if they dont already exist!
		echo copying original savegames
		# unmount the usb saves overmount so we can access the saves on nand
		if mountpoint -q $nand_saves; then
			umount $nand_saves || umount -f $nand_saves
		else
			umount $nand_saves 2>/dev/null
		fi
		# handle game saves
		for gamedir in "$indir"/CLV-*/ ; do
#			echo "checking savegame $gamedir"
			local gamecode="$(basename "$gamedir")"
			local savedir="$nand_saves/$gamecode/"
			if ! [ -d "$usb_saves/$gamecode" ] || [ -z "$(ls -A "$usb_saves/$gamecode")" ]; then
				if [ -d "$savedir" ] && ! [ -z "$(ls -A "$savedir")" ]; then
					toggleImportingLogo
					echo "      importing original save $savedir" | tee /dev/tty0
					cp -rf "$savedir" "$usb_saves/"
				fi
			fi
		done
		# handle system menu save
		local gamecode="home-menu"
		echo "checking savegame $gamecode"
		local savedir="$nand_saves/$gamecode/"
		if ! [ -d "$usb_saves/$gamecode" ] || [ -z "$(ls -A "$usb_saves/$gamecode")" ]; then
			if [ -d "$savedir" ] && ! [ -z "$(ls -A "$savedir")" ]; then
				echo copying in savegame "$gamecode" from "$savedir" to "$usb_saves/"
				toggleImportingLogo
				echo "      importing original save $savedir" | tee /dev/tty0
				cp -rf "$savedir" "$usb_saves/"
			fi
		fi
		# remount the usb saves overmount
		mount -o bind "$usb_saves" "$nand_saves"
	else
		# input dir didn't exist, so remove all original games
		rm -rf "$outdir"
	fi
	
	# create shortcuts if games exist in output dir
	if containsGames "$outdir"; then
		echo creating original games shortcuts
		# add shortcut to original games from root
		create_orig_shortcut "$usb_c2m_games_root/"
		# add shortcut to root from original games
		create_back_shortcut "$outdir/"
	# remove shortcuts if no games exist
	else
		echo removing original games shortcuts
		rm -rf "${usb_c2m_games_root:?}/${gamecode_original:?}"
		rm -rf "$outdir"
	fi
}


do_gameprep(){
	# general init
	PATH="$PATH:$usb_c2m_bin"
	mkdir -p "$usb_c2m_games_root"
	mkdir -p "$usb_saves"
	
	
	## prepare settings shortcuts
	#prepareSettings "$usb_c2m_games_settings_dir" "$usb_c2mromtool_settings"
	
	# copy across original games
	echo 
	echo preparing original games
	importOriginalGames "$rootfs_games" 
	
	
	# prepare random shortcut
	echo 
	echo preparing random shortcut
	# add random dir
	[ -d "$usb_c2m_games_rand_dir" ] || cp -rf "$usb_c2mromtool_templates/0RAND" "$usb_c2m_games/"
	# add shortcut to random from root
	create_rand_shortcut "$usb_c2m_games_root/"
	# add shortcut to root from random
	create_back_shortcut "$usb_c2m_games_rand_dir/"
	
	
	# prepare hakchi shortcut
	echo 
	echo preparing hakchi shortcut for "$usb_hakchi_games_other"
	# create shortcuts if games exist in output dir
	if containsGames "$usb_hakchi_games_other"; then
		# add shortcut to hakchi games
		if ! [ -d "$usb_c2m_games_root/$gamecode_hakchi" ]; then
			create_hakchi_shortcut "$usb_c2m_games_root/"
			
			# TODO: patch hakchi 001 desktop file to say "Back" (instead of "Original games")
			# But maybe we should not touch any Hakchi game content since it is not "ours"...
		fi
	else
		# remove shortcut to hakchi games
		rm -rf "${usb_c2m_games_root:?}/${gamecode_hakchi:?}"
	fi
	
	
	# remove old cartdumps and prepare new cartdump
	echo 
	echo preparing cartdump
	removeAllCartdumps "$usb_c2m_games_root"
	if ! [ -z "$cartdump_filename" ]; then
		echo current cartdump_filepath is: "$cartdump_filepath"
		echo adding new cartdump
		#echo "      importing gamecart" | tee /dev/tty0
		"$usb_c2mromtool" -r "$cartdump_filepath" -d "$usb_c2m_games_root" -z "d" -c1
        local cartdump_dir="$(dirname "$cartdump_filepath")"
        local cartdump_base="$(basename "$cartdump_filepath" .sfc)"
        local ips_filepath="$cartdump_dir/$cartdump_base.ips"
        if [ -f "$ips_filepath" ]; then
            echo "Copying IPS patch: $ips_filepath"
            cp "$ips_filepath" "$usb_c2m_games_root"/CLV-U-*/
        else
            echo "No IPS patch found"
        fi        
		# make the cartdump be the currently selected game
		echo 000 > "$usb_saves/hakchi/menu"
	fi
	
	
	# import new rom files
	echo 
	echo importing roms
	importAllGames "$usb_c2m_roms" "$usb_c2m_games"
	
	
	# import new rom favourite rom files
	echo 
	echo importing fave roms
	importFaveGames "$usb_c2m_roms_faves" "$usb_c2m_games_faves_dir"
	
	# check settings file if current game in current dir still exists
	# if not change that setting so it doesnt try to select a non-existant game
	# TODO
	
	
	echo
	echo
	echo ----------------------- c2m gameprep end ---------------------------
	echo
	echo
}


do_gameprep

