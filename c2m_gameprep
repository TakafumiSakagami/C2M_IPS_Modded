ALIGN_NONE=0

ALIGN_LEFT=11		# left most
ALIGN_LEFT1=11		# left most
ALIGN_LEFT2=12		# 2nd from left
ALIGN_LEFT3=13		# 3rd from left
ALIGN_LEFT4=14		# 4th from left
ALIGN_LEFT5=15		# 5th from left
ALIGN_LEFT6=16		# 6th from left
ALIGN_LEFT7=17		# 7th from left
ALIGN_LEFT8=18		# 8th from left
ALIGN_LEFT9=19		# 9th from left
ALIGN_LEFT_LAST=19	# last left alignment

ALIGN_RIGHT=21		# right most
ALIGN_RIGHT1=21		# right most
ALIGN_RIGHT2=22		# 2rd from right
ALIGN_RIGHT3=23		# 3th from right
ALIGN_RIGHT4=24		# 4th from right
ALIGN_RIGHT5=25		# 5th from right
ALIGN_RIGHT6=26		# 6th from right
ALIGN_RIGHT7=27		# 7th from right
ALIGN_RIGHT8=28		# 8th from right
ALIGN_RIGHT9=29		# 9th from right
ALIGN_RIGHT_LAST=29	# last right alignment

create_shortcut(){
	local outdir="$1"
	local sc_gamecode="$2"
	local sc_image="$3"
	local sc_name="$4"
	local sc_exec="$5"
	local sc_align="$6"
	local shortcut_dir="$outdir$sc_gamecode"
	local desktop_filename="$shortcut_dir/$sc_gamecode.desktop"
	local sc_name_lower=$(echo "$sc_name" | tr '[:upper:]' '[:lower:]')
	
#	cp -rf "$usb_c2mromtool_templates/$sc_gamecode" "$outdir/"
#	cp "$usb_c2mromtool_skin_misc/$sc_name".png       "$outdir/$sc_gamecode/$sc_gamecode".png
#	cp "$usb_c2mromtool_skin_misc/$sc_name"_small.png "$outdir/$sc_gamecode/$sc_gamecode"_small.png
	
	sc_align_prefix=""
	sc_align_date="1990-00-00"
	if [ "$sc_align" -ge $ALIGN_LEFT ] && [ "$sc_align" -le $ALIGN_LEFT_LAST ]; then
		num_symbols=$((ALIGN_LEFT_LAST-sc_align+1))
		i=0
		while [ $i -lt $num_symbols ]; do
			sc_align_prefix="$sc_align_prefix"$'\001'
#			(( i++ ))
			let i++
		done
		sc_align_date="$((1900+sc_align))-00-00"
	fi
	if [ "$sc_align" -ge $ALIGN_RIGHT ] && [ "$sc_align" -le $ALIGN_RIGHT_LAST ]; then
		num_symbols=$((ALIGN_RIGHT_LAST-sc_align+1))
		i=0
		while [ $i -lt $num_symbols ]; do
			sc_align_prefix="$sc_align_prefix~"
#			(( i++ ))
			let i++
		done
		sc_align_date="$((9900+num_symbols))-00-00"
	fi
	
	mkdir -p "$shortcut_dir"
	rm "$desktop_filename" 2> /dev/null
#	touch "$desktop_filename"
	{
		echo "[Desktop Entry]"
		echo "Type=Application"
		echo "Exec=$sc_exec"
		echo "Path=/var/saves/FOLDER"
		echo "Name=$sc_name"
		echo "Icon=/var/games/$sc_gamecode/$sc_gamecode.png"
		echo ""
		echo "[X-CLOVER Game]"
		echo "Code=$sc_gamecode"
		echo "TestID=0"
		echo "ID=0"
		echo "Players=1"
		echo "Simultaneous=0"
		echo "ReleaseDate=$sc_align_date"
		echo "SaveCount=0"
		echo "SortRawTitle=$sc_align_prefix$sc_name_lower"
		echo "SortRawPublisher=$sc_align_prefix"X
		echo "Copyright=X" 
	} > "$desktop_filename"

	# convert image to normal and small images
	convertImageBoth "$usb_c2mromtool_skin_misc/$sc_image".png "$shortcut_dir/$sc_gamecode".png "$shortcut_dir/$sc_gamecode"_small.png
}

