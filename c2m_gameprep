containsCartdump(){
	[ -d "$1" ] || return 1
	[ -z "$(cd "$1";ls cartdump 2>/dev/null)" ] && return 1
	return 0
}

findCartdump(){
	local basedir="$1"
	[ -d "$basedir" ] || return 1
	for subdir in "$basedir"/*/ ; do
		local cartdump_dir="$subdir"
		containsCartdump "$cartdump_dir" && echo "$cartdump_dir" && return 0
	done
	return 1
}

removeAllCartdumps(){
	local basedir="$1"
	[ -d "$basedir" ] || return 1
	for dir in "$basedir"/*/ ; do
		if containsCartdump "$dir"; then
			rm -rf "$dir"
		fi
	done
	return 0
}

