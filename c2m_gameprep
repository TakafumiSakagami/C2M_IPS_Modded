containsGames(){
  [ -d "$1" ] || return 1
  [ -z "$(cd "$1";ls CLV-* 2>/dev/null)" ] && return 1
  return 0
}

checkGamepath(){
	containsGames "$1" && echo "$1" && return 0
	return 1
}

findGameStorage(){
