stopTask(){
  local tokill="false"
  if [ "$1" = "-f" ]; then
    tokill="true"
    shift
  fi
  local pid="$(pidof "$1")"
  [ -z "$pid" ] && return 0
  "$tokill" && kill "$pid"
  wait "$pid"
}

waitTask(){
	local A="stopTask ${1+"$@"}"
	trap "$A" EXIT
}

showImage(){
	local image="$(eval echo "$1")"
	[ -f "$image" ] || return 1
	decodepng "$image" > "/dev/fb0" &
	waitTask decodepng
	return 0
}

